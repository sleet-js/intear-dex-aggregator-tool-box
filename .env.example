# intear dex-aggregator tool box env example
# Copy to .env and fill in real values (do NOT commit .env).
#
# `.env` is loaded for you by `@near-kit-tool-box/env` (used by the
# bins), so you do NOT need `set -a; source .env; set +a`.
# =================================================
# Network: the intear router only serves mainnet routes.
# Quoting works without credentials; executing needs a mainnet signer.
export NEAR_NETWORK=mainnet
# Signing account + key (required only to EXECUTE a swap).
# NEAR_PRIVATE_KEY must be the 64-byte secret key: the `ed25519:`
# prefix followed by ~88 base58 characters. The account's public key
# is NOT accepted here and fails with an opaque `HTTP 400`.
export NEAR_ACCOUNT_ID=you.near
export NEAR_PRIVATE_KEY=ed25519:YOUR_PRIVATE_KEY_HERE
# =================================================
# Dex-aggregator quote defaults (all optional, CLI args win over env)
# Token ids: `near` for native NEAR, otherwise the NEP-141 contract
# (the `nep141:` prefix is accepted too and passed through as-is).
# The router also accepts `rhea-nep141:<id>` for tokens sitting on
# Rhea, and `intear-dex:<id>` for tokens on Intear's DEX.
export DEX_AGG_TOKEN_IN=near
export DEX_AGG_TOKEN_OUT=usdt.tether-token.near
# Amount in the input token's smallest unit (0.1 NEAR here)
export DEX_AGG_AMOUNT_IN=100000000000000000000000
# Fixed slippage as a decimal (0.01 = 1%)
export DEX_AGG_SLIPPAGE=0.01
# Max time the router may spend finding a quote (ms, up to 60000)
export DEX_AGG_MAX_WAIT_MS=2000
# Optional comma list of DEXes (default: all). Only these serve quotes
# today: Rhea, RheaDcl, Plach, Wrap.
export DEX_AGG_DEXES=
# Optional referrer credited (and possibly paid) on supported DEXes
export DEX_AGG_REFERRER_ID=
# Optional: account used for storage-deposit actions (defaults to the signer)
export DEX_AGG_TRADER_ACCOUNT_ID=
# Optional: your own referral fee, charged on the input of every swap.
# Set BOTH: the account to pay, and the fraction (0.005 = 0.5%).
# Up to 4 accounts and 5% total, each a multiple of 0.000001.
# The quote's estimated_amount already has the fee subtracted.
export DEX_AGG_FEE_ACCOUNT_ID=
export DEX_AGG_FEE=
# Optional: the signer's OWN public key (never the private key). With it,
# each quote carries a `signing` block (nonce + block hash) so you can
# sign the route's transactions without asking an RPC for a nonce.
# A key that belongs to a different account is accepted but silently
# yields no `signing`, so check the quote has one.
export DEX_AGG_SIGNING_PUBLIC_KEY=
# Optional: how long the `subscribe` bin watches, in seconds (default 20)
export DEX_AGG_SUBSCRIBE_SECONDS=20
# Optional: override the router base url + api key (rate-limit bypass)
export DEX_AGGREGATOR_BASE_URL=https://router.intear.tech
export DEX_AGGREGATOR_API_KEY=
# =================================================