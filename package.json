{
  "name": "@sleet-js/intear-dex-aggregator-tool-box",
  "version": "0.1.0",
  "description": "Typed client + near-kit execution helpers for the intear dex-aggregator (https://router.intear.tech).",
  "license": "MIT",
  "homepage": "https://sleet-js.near.page",
  "repository": {
    "type": "git",
    "url": "https://github.com/sleet-js/intear-dex-aggregator-tool-box.git"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "workspaces": ["html"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "swap": "bun run bin/dex_aggregator_swap_bin.ts",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "near-kit": "^0.20.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "files": [
    "dist"
  ]
}
