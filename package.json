{
  "name": "intear-dex-aggregator-tool-box",
  "version": "0.1.0",
  "description": "Typed client + near-kit execution helpers for the intear dex-aggregator (https://router.intear.tech).",
  "license": "MIT",
  "homepage": "https://sleet-js.near.page",
  "repository": {
    "type": "git",
    "url": "https://github.com/sleet-js/intear-dex-aggregator-tool-box.git"
  },
  "module": "dist/index.ts",
  "types": "dist/index.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.ts",
      "default": "./dist/index.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "workspaces": ["html"],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "swap": "bun run bin/dex_aggregator_swap_bin.ts",
    "prepublishOnly": "bun run build"
  },
  "dependencies": {
    "near-kit": "^0.20.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "files": [
    "README.md",
    "LICENSE",
    "src/**/*",
    "!src/**/*.test.ts",
    "dist/**/*",
    "!dist/**/*.test.ts",
    "!dist/**/*.test.ts.map"
  ],
  "//": "compatible with near-kit and near-kit-tool-box-ts; quoted deps are unpinned for max flexibility — bump together with near-kit."
}
