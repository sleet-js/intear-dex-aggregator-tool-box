{
  "name": "@sleet-js/intear-dex-aggregator-tool-box",
  "version": "0.1.2",
  "description": "Typed client + near-kit execution helpers for the intear dex-aggregator (https://router.intear.tech).",
  "license": "MIT",
  "homepage": "https://sleet-js.near.page",
  "repository": {
    "type": "git",
    "url": "https://github.com/sleet-js/intear-dex-aggregator-tool-box.git"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "workspaces": [
    "html"
  ],
  "scripts": {
    "build": "rm -f .tsbuildinfo && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist .tsbuildinfo",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test": "bun test",
    "swap": "bun run bin/dex_aggregator_swap_bin.ts",
    "subscribe": "bun run bin/dex_aggregator_subscribe_bin.ts",
    "prepublishOnly": "bun run build",
    "typecheck:html": "cd html && tsc --noEmit -p tsconfig.json",
    "typecheck:all": "bun run typecheck && bun run typecheck:html",
    "version:sync": "bun run scripts/version-sync.ts",
    "version:dry-run": "bun run scripts/version-sync.ts --dry-run",
    "release:version": "bun run scripts/release-version.ts"
  },
  "dependencies": {
    "@near-kit-tool-box/env": "^0.3.0",
    "near-kit": "^0.20.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "files": [
    "dist"
  ]
}
